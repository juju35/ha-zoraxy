{
  "config": {
    "step": {
      "user": {
        "title": "Zoraxy - Configuration",
        "data": {
          "host": "Zoraxy address (URL with port)",
          "username": "Username",
          "password": "Password",
          "scan_interval": "Refresh interval (seconds)",
          "verify_ssl": "Verify the TLS certificate"
        },
        "data_description": {
          "verify_ssl": "Turn off only for an HTTPS address with a self-signed certificate."
        }
      },
      "reauth_confirm": {
        "title": "Zoraxy - New password",
        "description": "Zoraxy refused the password of {username} on {host}.",
        "data": {
          "password": "Password"
        }
      }
    },
    "error": {
      "cannot_connect": "Cannot connect to Zoraxy",
      "invalid_auth": "Invalid credentials",
      "unknown": "Unknown error"
    },
    "abort": {
      "already_configured": "Zoraxy is already configured",
      "reauth_successful": "Password updated"
    }
  },
  "options": {
    "step": {
      "init": {
        "title": "Zoraxy - Options",
        "data": {
          "scan_interval": "Refresh interval (seconds)",
          "verify_ssl": "Verify the TLS certificate"
        },
        "data_description": {
          "verify_ssl": "Turn off only for an HTTPS address with a self-signed certificate."
        }
      }
    }
  },
  "entity": {
    "sensor": {
      "proxy_rules": {
        "name": "Proxy rules"
      },
      "active_rules": {
        "name": "Active rules"
      },
      "tls_certificates": {
        "name": "TLS certificates"
      },
      "access_rules": {
        "name": "Access rules"
      },
      "inbound_port": {
        "name": "Inbound port"
      },
      "certificate": {
        "name": "{domain} certificate"
      }
    },
    "binary_sensor": {
      "proxy_running": {
        "name": "Proxy running"
      },
      "tls_enabled": {
        "name": "TLS enabled"
      },
      "https_redirect": {
        "name": "HTTPS redirect"
      },
      "port_80": {
        "name": "Port 80 listener"
      },
      "development_mode": {
        "name": "Development mode"
      },
      "certificate_expiring": {
        "name": "{domain} certificate expiring"
      }
    },
    "switch": {
      "https_redirect": {
        "name": "HTTPS redirect"
      },
      "port_80": {
        "name": "Port 80 listener"
      },
      "development_mode": {
        "name": "Development mode"
      }
    },
    "button": {
      "renew": {
        "name": "Renew {domain}"
      }
    }
  },
  "services": {
    "toggle_proxy_rule": {
      "name": "Toggle proxy rule",
      "description": "Enable or disable a Zoraxy proxy rule.",
      "fields": {
        "domain": {
          "name": "Domain",
          "description": "The domain of the proxy rule (e.g. \"example.com\")."
        },
        "enable": {
          "name": "Enable",
          "description": "Set to true to enable the rule, false to disable it. Leave out to toggle the rule."
        }
      }
    }
  },
  "exceptions": {
    "no_instance": {
      "message": "No Zoraxy instance is loaded"
    },
    "rule_not_found": {
      "message": "Zoraxy proxy rule {domain} not found"
    },
    "rule_change_failed": {
      "message": "Zoraxy: could not change the rule {domain}: {error}"
    },
    "acme_email_unavailable": {
      "message": "Zoraxy: ACME email not available"
    },
    "renewal_failed": {
      "message": "Zoraxy: renewal of {domain} failed: {error}"
    },
    "command_failed": {
      "message": "Zoraxy: {error}"
    }
  }
}
